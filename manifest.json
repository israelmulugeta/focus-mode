{
  "manifest_version": 3,
  "name": "QA Test Case TSV Converter",
  "description": "Convert QA test cases from TXT files into TSV or CSV for spreadsheets entirely in Chrome.",
  "version": "1.0.0",
  "action": {
    "default_title": "QA TSV Converter",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
